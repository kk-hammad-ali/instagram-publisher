# Credentials - never commit. The .env* glob covers rotation backups
# (.env.bak.YYYYMMDD), which hold a previous live token.
.env*
!.env.example

# The DK commercial is 95MB. Reels publish by resumable upload straight from
# this machine, so unlike the stills they never need a public URL and must not
# go in git - GitHub rejects blobs over 100MB outright.
media/dk/*.mp4
.DS_Store

# Python bytecode
__pycache__/
*.pyc
